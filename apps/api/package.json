{
  "name": "@chaintelescope/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "pnpm build && node dist/db/migrate-cli.js",
    "db:migrate:down": "pnpm build && node dist/db/migrate-cli.js --down",
    "db:seed": "pnpm build && node dist/db/migrate-cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.11",
    "@chaintelescope/shared": "workspace:*",
    "hapi-pino": "^13.0.0",
    "joi": "^18.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.5"
  }
}
