{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-redux",
            "message": "Use the typed hooks from src/store/hooks.ts; Provider belongs in src/store/StoreProvider.tsx."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/store/hooks.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/store/StoreProvider.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-redux",
                "allowImportNames": ["Provider"],
                "message": "Only Provider is allowed in StoreProvider."
              }
            ]
          }
        ]
      }
    }
  ]
}
