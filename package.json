{
  "name": "chaintelescope",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @chaintelescope/shared build",
    "build:api": "pnpm --filter @chaintelescope/api build",
    "build:web": "pnpm --filter @chaintelescope/web build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @chaintelescope/api dev",
    "dev:web": "pnpm --filter @chaintelescope/web dev",
    "start": "pnpm --filter @chaintelescope/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "test": "pnpm build && pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @chaintelescope/api test:integration",
    "test:coverage": "pnpm -r test:coverage",
    "test:watch": "pnpm -r test:watch",
    "api:openapi": "pnpm build:shared && pnpm build:api && pnpm --filter @chaintelescope/openapi generate",
    "api:openapi:check": "pnpm api:openapi && git diff --exit-code -- packages/openapi/openapi.json",
    "db:migrate": "pnpm --filter @chaintelescope/api db:migrate",
    "db:migrate:down": "pnpm --filter @chaintelescope/api db:migrate:down",
    "db:seed": "pnpm --filter @chaintelescope/api db:seed",
    "db:reset": "pnpm --filter @chaintelescope/api db:reset",
    "docker:build": "docker build -t chaintelescope-api -f apps/api/Dockerfile .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "profile:cpu": "node --prof apps/api/dist/main.js",
    "profile:process": "node --prof-process isolate-*.log > v8-profile.txt",
    "clean": "pnpm -r exec rm -rf dist node_modules coverage .turbo",
    "clean:hard": "git clean -xdf -e .env*"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^6.0.2"
  }
}
